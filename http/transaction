#!/bin/bash

# --- CONFIGURATION ---
API_URL="http://localhost:3000"
TREASURY="00000000-0000-0000-0000-000000000000"
ACCOUNT_A="11111111-1111-1111-1111-111111111111"
ACCOUNT_B="22222222-2222-2222-2222-222222222222"

echo "=== 1. Creating Account A (Depositing 1000 from Treasury) ==="
curl -X POST "$API_URL/transfers" \
  -H "Content-Type: application/json" \
  -d "{
    \"from_account\": \"$TREASURY\",
    \"to_account\": \"$ACCOUNT_A\",
    \"amount\": 1000,
    \"idempotency_key\": \"$(uuidgen 2>/dev/null || echo "a01a3cf8-54c7-4b53-90d5-6ff1c3b1a8d0")\"
  }"
echo -e "\n"

echo "=== 2. Creating Account B (Depositing 500 from Treasury) ==="
curl -X POST "$API_URL/transfers" \
  -H "Content-Type: application/json" \
  -d "{
    \"from_account\": \"$TREASURY\",
    \"to_account\": \"$ACCOUNT_B\",
    \"amount\": 500,
    \"idempotency_key\": \"$(uuidgen 2>/dev/null || echo "b78a9c3b-dfb1-4f11-85e6-ec083b4b0e8c")\"
  }"
echo -e "\n"

echo "=== 3. Transferring 300 from Account A to Account B ==="
curl -X POST "$API_URL/transfers" \
  -H "Content-Type: application/json" \
  -d "{
    \"from_account\": \"$ACCOUNT_A\",
    \"to_account\": \"$ACCOUNT_B\",
    \"amount\": 300,
    \"idempotency_key\": \"$(uuidgen 2>/dev/null || echo "c25db9ea-7871-46ab-ae98-0c3eb1df93d7")\"
  }"
echo -e "\n"
