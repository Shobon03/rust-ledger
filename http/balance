#!/bin/bash

# --- CONFIGURATION ---
API_URL="http://localhost:3000"
TREASURY="00000000-0000-0000-0000-000000000000"
ACCOUNT_A="11111111-1111-1111-1111-111111111111"
ACCOUNT_B="22222222-2222-2222-2222-222222222222"

echo "=== Querying Treasury Balance ==="
curl -s "$API_URL/accounts/$TREASURY/balance" | json_pp 2>/dev/null || curl -s "$API_URL/accounts/$TREASURY/balance"
echo -e "\n"

echo "=== Querying Account A Balance ==="
curl -s "$API_URL/accounts/$ACCOUNT_A/balance" | json_pp 2>/dev/null || curl -s "$API_URL/accounts/$ACCOUNT_A/balance"
echo -e "\n"

echo "=== Querying Account B Balance ==="
curl -s "$API_URL/accounts/$ACCOUNT_B/balance" | json_pp 2>/dev/null || curl -s "$API_URL/accounts/$ACCOUNT_B/balance"
echo -e "\n"
