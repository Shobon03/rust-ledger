#!/bin/bash

# --- CONFIGURATION ---
API_URL="http://localhost:3000"
TREASURY="00000000-0000-0000-0000-000000000000"
ACCOUNT_A="11111111-1111-1111-1111-111111111111"
ACCOUNT_B="22222222-2222-2222-2222-222222222222"

echo "=== Querying Treasury Statement ==="
curl -s "$API_URL/accounts/$TREASURY/transactions" | json_pp 2>/dev/null || curl -s "$API_URL/accounts/$TREASURY/transactions"
echo -e "\n"

echo "=== Querying Account A Statement ==="
curl -s "$API_URL/accounts/$ACCOUNT_A/transactions" | json_pp 2>/dev/null || curl -s "$API_URL/accounts/$ACCOUNT_A/transactions"
echo -e "\n"

echo "=== Querying Account B Statement ==="
curl -s "$API_URL/accounts/$ACCOUNT_B/transactions" | json_pp 2>/dev/null || curl -s "$API_URL/accounts/$ACCOUNT_B/transactions"
echo -e "\n"
